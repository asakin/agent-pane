{
  "name": "siglify/agent-pane",
  "dependencies": {},
  "actions": {
    "follow-ticket-changes": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-haiku-4-5",
      "skill": "tessl/factory#follow-ticket-changes",
      "environment": "factory-siglify-agent-pane-follow-ticket-changes"
    },
    "shepherd": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/factory#shepherd",
      "concurrency": {
        "keys": [
          {
            "key": "github:pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ],
        "debounce": "90s"
      },
      "environment": "factory-siglify-agent-pane-shepherd"
    },
    "implement": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/factory#implement-github-issue",
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      },
      "environment": "factory-siglify-agent-pane-implement"
    }
  },
  "triggers": {
    "follow-ticket-changes-issue-unlabelled": {
      "on": [
        "github:issues.unlabeled"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            575070
          ]
        },
        "event.label.name": "tessl"
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "taken-back",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-issue-closed": {
      "on": [
        "github:issues.closed"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            575070
          ]
        },
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "issue-ended",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-issue-replied": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "false",
        "event.sender.id": {
          "in": [
            575070
          ]
        },
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "replied",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-pr-closed": {
      "on": [
        "github:pull_request.closed"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            575070
          ]
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "pr-closed",
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}",
          "GITHUB_ISSUE_LABEL": "tessl"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "shepherd-pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            575070
          ]
        },
        "event.pull_request.state": "open",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1449581805,
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "shepherd-pr-review-comment": {
      "on": [
        "github:pull_request_review_comment.created"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            575070
          ]
        },
        "event.pull_request.state": "open",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1449581805,
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "shepherd-pr-comment": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "true",
        "event.sender.id": {
          "in": [
            575070
          ]
        },
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "implement": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl"
      },
      "action": {
        "use": "implement",
        "inputs": {
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    }
  },
  "verify": {
    "groups": {
      "extension-background-senders": {
        "path": "verifiers/background-senders-own-extension-only.json",
        "level": "error",
        "include": [
          "extension/entrypoints/background.ts",
          "extension/entrypoints/shared/sender.ts",
          "extension/entrypoints/shared/terminal.ts"
        ]
      },
      "pty-websocket-security": {
        "path": "verifiers/pty-websocket-origin-token.json",
        "level": "error",
        "include": [
          "internal/cmd/serve.go"
        ]
      },
      "native-rpc-coverage": {
        "path": "verifiers/native-rpc-method-cross-layer-coverage.json",
        "level": "error",
        "include": [
          "extension/entrypoints/shared/rpc.ts",
          "extension/entrypoints/background.ts",
          "internal/cmd/serve.go",
          "internal/cmd/page.go",
          "extension/tests/*.test.mjs",
          "internal/cmd/**/*_test.go"
        ]
      },
      "page-content-security": {
        "path": "verifiers/page-content-endpoint-boundaries.json",
        "level": "error",
        "include": [
          "README.md",
          "extension/entrypoints/**/*.ts",
          "internal/cmd/**/*.go"
        ],
        "exclude": [
          "internal/cmd/themes/**"
        ]
      },
      "workflow-dispatch-docs": {
        "path": "verifiers/workflow-dispatch-readme-doc.json",
        "level": "error",
        "include": [
          ".github/workflows/ci.yml",
          "README.md"
        ]
      }
    }
  }
}
